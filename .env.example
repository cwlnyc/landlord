# Copy to .env.local (gitignored) and fill in. Never commit a real key.
# From the Claude Console (console.anthropic.com): separate from a claude.ai plan.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-opus-5-5).
# REPAIR_MODEL=

# --- The real phone number (npm run live) ---
# From the Twilio console (twilio.com/console). The auth token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The repair line's number, e.g. +12035550100
TWILIO_NUMBER=
# The public address Twilio sends texts to (your tunnel), without /sms
PUBLIC_URL=
# While testing: only text these numbers (comma-separated). Others are logged.
ALLOW_ONLY=
