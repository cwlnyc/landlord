# Copy to .env.local (gitignored) and fill in. Never commit a real key.
# From the Claude Console (console.anthropic.com): separate from a claude.ai plan.
ANTHROPIC_API_KEY=
# Models: the line tries the cheap one first and asks the strong one only
# when the cheap one isn't sure or its answer doesn't check out. Defaults:
# AI_CHEAP_MODEL=claude-haiku-5-5
# AI_STRONG_MODEL=claude-opus-5-5
# AI_SEARCH_MODEL=claude-sonnet-5-5
# Or put every job on one model:
# REPAIR_MODEL=

# --- The real phone number (npm run live) ---
# From the Twilio console (twilio.com/console). The auth token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The repair line's number, e.g. +12035550100
TWILIO_NUMBER=
# Leave empty: npm run live starts its own tunnel and sets the Twilio webhook.
# Only set it if the line has a fixed address (a host), without /sms.
PUBLIC_URL=
# While testing: only text these numbers (comma-separated). Others are logged.
ALLOW_ONLY=
